# ===========================================================================
# Hat Cab - Keystore Properties Template (Local Signing Configuration)
# Copy this file to 'keystore.properties' (ignored by version control)
# ===========================================================================

# Path to your release keystore (.jks or .keystore file)
storeFile=/path/to/your/upload-keystore.jks

# Keystore password
storePassword=YourKeystorePasswordHere

# Key alias inside the keystore
keyAlias=upload

# Key password
keyPassword=YourKeyPasswordHere
